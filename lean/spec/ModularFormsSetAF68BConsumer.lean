/-
  SET-AF68B consumer: strong multiplicity one in weight two for the `Γ_H(M)`-Hecke algebra,
  fired at the terminal data `M = 2`, `H = ⊤`, `S = ∅`.

  **The zone.** One row, hence one composition:
  `FLTForHuman/ModularForms/WeightTwoMultiplicityOne.lean`'s
  `CuspForm.nonempty_basis_fin_one_gammaH_and_finrank_eigenspace_eq_one`.

  **The reading.** The headline needs no datum: its hypotheses are `[NeZero M]`, a subgroup
  `H ≤ (ZMod M)ˣ`, a finite prime set `S`. So the smallest data is `M = 2`, `H = ⊤`,
  `S = ∅` (`hSfin` is `Set.finite_empty`), and the consumer *executes* the composition there.

  * Zone A. The first conjunct produces a `Fin 1`-indexed `↥𝔸₂`-basis `b` of the weight-two
    `Γ_⊤(2)`-cusp form space `W₂`. The consumer picks it (`Classical.choice`, since the
    headline is an existence statement) and spends it twice: `b` spans (`b.span_eq`) — one
    vector generates `W₂` over the operator algebra — and, since the index type is `Fin 1`,
    every `v : W₂` is the single multiple `(b.repr v 0) • b 0`, which is what a
    one-dimensional eigenbasis *means* as an algebra module.
  * Zone B. The second conjunct fixes every character `χ : ↥𝔸₂ →ₐ[ℂ] ℂ` and returns the
    `ℂ`-dimension of the simultaneous eigenspace `⋂ a, eigenspace a (χ a)`. The consumer reads
    it as `finrank = 1`, and spends it as `finrank ≠ 0`: the line is not the zero space, i.e.
    a character of the operator algebra is realised by a nonzero simultaneous eigenvector.
    The character itself is kept in hypothesis form — a `ℂ`-algebra map from `𝔸₂` to `ℂ` need
    not exist for arbitrary data (the pin's `eigen_le_one` reads its statement the same way),
    so fabricating one would prove less, not more.

  This module is outside every library: it is a spec-side composition check, not part of the
  port's import graph.
-/
import FLTForHuman.ModularForms.WeightTwoMultiplicityOne

set_option autoImplicit false

noncomputable section

open Module

namespace WeightTwoEigenformSpace

namespace AF68BConsumer

/-- The weight-two cusp form space `W = CuspForm Γ_H(2) 2` at `H = ⊤`. -/
abbrev W₂ : Type := W 2 ⊤

/-- The `ℂ`-subalgebra of `Module.End ℂ W₂` generated by the `T_ℓ` with `ℓ ∉ ∅`, the `U_q` with
`q ∣ 2` and the diamonds, at `H = ⊤` and `S = ∅`. -/
abbrev 𝔸₂ : Subalgebra ℂ (Module.End ℂ W₂) := 𝔸 2 ⊤ ∅

/-- Zone A: the headline's first conjunct, fired at `M = 2`, `H = ⊤`, `S = ∅`. -/
theorem nonempty_basis_at_two : Nonempty (Module.Basis (Fin 1) ↥𝔸₂ W₂) :=
  (CuspForm.nonempty_basis_fin_one_gammaH_and_finrank_eigenspace_eq_one 2 ⊤ ∅
    Set.finite_empty).1

/-- The eigenbasis, chosen. -/
def basisAtTwo : Module.Basis (Fin 1) ↥𝔸₂ W₂ := nonempty_basis_at_two.some

/-- Zone A: the one basis vector generates `W₂` over `𝔸₂`. -/
theorem span_basisAtTwo : Submodule.span ↥𝔸₂ (Set.range basisAtTwo) = ⊤ :=
  basisAtTwo.span_eq

/-- Zone A: over a `Fin 1`-indexed basis every vector is a single multiple of the basis vector,
which is the content of "one-vector eigenbasis" read as an `𝔸₂`-module statement. -/
theorem eq_smul_basisAtTwo (v : W₂) : ∃ c : ↥𝔸₂, v = c • basisAtTwo 0 := by
  refine ⟨basisAtTwo.repr v 0, ?_⟩
  conv_lhs => rw [← basisAtTwo.sum_repr v]
  simp

/-- Zone B: the headline's second conjunct, fired at `M = 2`, `H = ⊤`, `S = ∅`, at an arbitrary
character of the operator algebra. -/
theorem finrank_eigenspace_at_two (χ : ↥𝔸₂ →ₐ[ℂ] ℂ) :
    Module.finrank ℂ ↥(⨅ a : ↥𝔸₂, Module.End.eigenspace (a : Module.End ℂ W₂) (χ a)) = 1 :=
  (CuspForm.nonempty_basis_fin_one_gammaH_and_finrank_eigenspace_eq_one 2 ⊤ ∅
    Set.finite_empty).2 χ

/-- Zone B: the common eigenspace of a character is not the zero space — the line carries a
nonzero simultaneous eigenvector. -/
theorem finrank_eigenspace_at_two_ne_zero (χ : ↥𝔸₂ →ₐ[ℂ] ℂ) :
    Module.finrank ℂ ↥(⨅ a : ↥𝔸₂, Module.End.eigenspace (a : Module.End ℂ W₂) (χ a)) ≠ 0 := by
  rw [finrank_eigenspace_at_two χ]
  norm_num

end AF68BConsumer

end WeightTwoEigenformSpace
