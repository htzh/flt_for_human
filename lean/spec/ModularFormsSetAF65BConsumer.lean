/-
  Cross-module wire test for SET-AF65B (the weight-two coefficient ring, and the `Γ_H` dictionary).

  A `spec/` probe, not a library module. Every zone below *consumes* one of the six headlines
  rather than restating it, and the witness everywhere a hypothesis would otherwise have to be
  invented is the zero cusp form --- the only form for which `HasNebentypus`, the vanishing of
  every `q`-coefficient and `Γ_H`-invariance are all available without constructing anything.

  * **Zone D, row `CuspForm.IsEigenformWith.fg_adjoin_qCoeff`.** The headline's conclusion is
    `Module.Finite`-shaped only after `Module.Finite.iff_fg`; here the `FG` module it produces is
    fed to `isNoetherian_of_fg_of_noetherian`, so what is consumed is the *Noetherianity* of the
    coefficient ring, not the headline's own conclusion. The eigenform hypothesis is carried, not
    discharged: no eigenform is constructed anywhere in the corpus.

  * **Zone E, row `CuspForm.IsEigenformWith.OperatorAlgebra.finite_adjoin_qCoeff`.** The same
    coefficient ring, read through the operator-algebra form: `Module.Finite.iff_fg` recovers the
    `FG` statement from the headline's `Module.Finite`, so the two rows are wired to each other
    through mathlib rather than through the port.

  * **Zone F, row `CuspForm.exists_gamma1_coe_eq_of_gammaH`.** Two readings. First the row alone at
    `H = ⊥`, `f = 0`: the `Γ₁`-form it returns exists. Second --- the composition that gives the
    row its content --- a `Γ₁`-nebentypus form is pushed *up* to `Γ_H(⊤)` by row G and pulled back
    *down* by row F; the composite returns a `Γ₁`-form with the original function, which neither
    row states on its own.

  * **Zone G, row `CuspForm.exists_gammaH_coe_eq_of_hasNebentypus`.** At `H = ⊥` the hypothesis
    `ε|_H = 1` is discharged outright (`⊥` has one element, `1`, and `ε 1 = 1`), so the row is
    applied with no leftover premise.

  * **Zone H, row `CuspForm.coe_diamondLinH_and_coe_heckeTLinH_and_coe_heckeULinH_of_hasNebentypus`.**
    The first component of the triple is extracted at `f = g = 0` and yields the statement that
    the `⟨d⟩`-operator's underlying function on the zero form is `0`; the `T_ℓ` and `U_q`
    components are `0` for the same reason.

  * **Zone I, row `CuspForm.exists_finset_dirichlet_sum_eq_and_independent_of_gammaH`.** Both
    conjuncts are consumed at once: the decomposition half produces the finite index set and the
    components, and the independence half is then applied to those very components to conclude
    that each of them vanishes. The file contains no interactive probes and no placeholder proofs.
-/
import FLTForHuman.ModularForms.CoefficientRing
import FLTForHuman.ModularForms.GammaHDictionary

set_option autoImplicit false

noncomputable section

open CongruenceSubgroup
open scoped MatrixGroups ModularForm

namespace SetAF65BConsumer

/-! ## The zero form, as the witness of every zone whose premises are existential -/

/-- The zero cusp form has every nebentypus character: both sides of the twist law are `0`. -/
theorem hasNebentypus_zero {N : ℕ} {k : ℤ} (ε : DirichletCharacter ℂ N) :
    CuspForm.HasNebentypus ε (0 : CuspForm (CongruenceSubgroup.Gamma1 N) k) := by
  intro γ hγ τ
  simp

/-- The zero form is `Γ_H`-invariant, so it is a legitimate `Γ_H`-cusp form. -/
theorem coe_zero_gammaH {N : ℕ} {k : ℤ} (H : Subgroup (ZMod N)ˣ) :
    (⇑(0 : CuspForm (CohCarrier.GammaH N H) k) : UpperHalfPlane → ℂ) = 0 :=
  FunLike.coe_zero

/-! ## Zones D and E: the coefficient ring of a weight-two eigenform -/

/-- **Zone D.** The `ℤ`-algebra generated by the `q`-coefficients of a weight-two eigenform and
the values of its nebentypus is a Noetherian `ℤ`-module. The headline supplies the finite
generation and `isNoetherian_of_fg_of_noetherian` turns it into the Noetherian statement; the
eigenform itself is the hypothesis, since no eigenform is constructed in the corpus. -/
theorem zoneD_isNoetherian {M : ℕ} [NeZero M] {ε : DirichletCharacter ℂ M}
    {h : CuspForm (CongruenceSubgroup.Gamma1 M) 2} (hh : CuspForm.IsEigenformWith ε h) :
    IsNoetherian ℤ ↥(Algebra.adjoin ℤ
      ((Set.range fun n : ℕ => ModularFormClass.qCoeff h n) ∪
        Set.range fun u : (ZMod M)ˣ => ε (u : ZMod M))) :=
  isNoetherian_of_fg_of_noetherian _
    (CuspForm.IsEigenformWith.fg_adjoin_qCoeff hh)

/-- **Zone E.** The operator-algebra form of zone D, read back as finite generation through
`Module.Finite.fg` --- so the `FG` statement here is produced from the `Module.Finite` headline,
not from zone D's `FG` headline. -/
theorem zoneE_fg {M : ℕ} [NeZero M] {ε : DirichletCharacter ℂ M}
    {h : CuspForm (CongruenceSubgroup.Gamma1 M) 2} (hh : CuspForm.IsEigenformWith ε h) :
    (Subalgebra.toSubmodule (Algebra.adjoin ℤ
      ((Set.range fun n : ℕ => ModularFormClass.qCoeff h n) ∪
        Set.range fun u : (ZMod M)ˣ => ε (u : ZMod M)))).FG :=
  Module.Finite.iff_fg.1 (CuspForm.IsEigenformWith.OperatorAlgebra.finite_adjoin_qCoeff hh)

/-! ## Zone F: a `Γ_H`-form is a `Γ₁`-form -/

/-- **Zone F alone**, at `H = ⊥`: the `Γ₁(M)`-cusp form with the same underlying function as a
given `Γ_{⊥}(M)`-cusp form exists. -/
theorem zoneF_gamma1_of_gammaH (M : ℕ) [NeZero M] (k : ℤ)
    (f : CuspForm (CohCarrier.GammaH M ⊥) k) :
    ∃ g : CuspForm (CongruenceSubgroup.Gamma1 M) k, (⇑g : UpperHalfPlane → ℂ) = ⇑f :=
  CuspForm.exists_gamma1_coe_eq_of_gammaH M ⊥ k f

/-- **Zone F composed with zone G.** A `Γ₁(M)`-cusp form with a nebentypus trivial on `H` is
pushed up to `Γ_H(M)` by row G and pulled back down to `Γ₁(M)` by row F; the composite returns a
`Γ₁(M)`-form with the original underlying function. This is the round trip neither row states. -/
theorem zoneFG_roundtrip (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ) (k : ℤ)
    (ε : DirichletCharacter ℂ M) (hε : ∀ d : (ZMod M)ˣ, d ∈ H → ε (d : ZMod M) = 1)
    (g : CuspForm (CongruenceSubgroup.Gamma1 M) k) (hg : CuspForm.HasNebentypus ε g) :
    ∃ g' : CuspForm (CongruenceSubgroup.Gamma1 M) k, (⇑g' : UpperHalfPlane → ℂ) = ⇑g := by
  obtain ⟨f, hf⟩ := CuspForm.exists_gammaH_coe_eq_of_hasNebentypus M H k ε hε g hg
  obtain ⟨g', hg'⟩ := CuspForm.exists_gamma1_coe_eq_of_gammaH M H k f
  exact ⟨g', hg'.trans hf⟩

/-! ## Zone G: a nebentypus form is a `Γ_H`-form -/

/-- **Zone G** at `H = ⊥`, where the nebentypus hypothesis `ε|_H = 1` is *discharged*: `⊥` has
the single element `1` and `ε 1 = 1`. The witness form is the zero form, which carries every
character. -/
theorem zoneG_gammaH_of_zero (M : ℕ) [NeZero M] (k : ℤ) (ε : DirichletCharacter ℂ M) :
    ∃ f : CuspForm (CohCarrier.GammaH M ⊥) k,
      (⇑f : UpperHalfPlane → ℂ) = ⇑(0 : CuspForm (CongruenceSubgroup.Gamma1 M) k) := by
  refine CuspForm.exists_gammaH_coe_eq_of_hasNebentypus M ⊥ k ε ?_ 0 (hasNebentypus_zero ε)
  intro d hd
  rw [Subgroup.mem_bot] at hd
  subst hd
  simp

/-! ## Zone H: the `⟨d⟩`/`T_ℓ`/`U_q` action on a nebentypus form -/

/-- **Zone H**, first component, at `f = g = 0`: the underlying function of `diamondLinH k d` on
the zero `Γ_H(M)`-form is `0` --- which is the row's statement `⇑(⟨d⟩ f) = ε d • ⇑g` read at the
zero form, where both sides are zero. -/
theorem zoneH_diamond_zero (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ) (k : ℤ)
    (ε : DirichletCharacter ℂ M) (d : (ZMod M)ˣ) :
    (⇑(CuspForm.diamondLinH k d (0 : CuspForm (CohCarrier.GammaH M H) k)) :
        UpperHalfPlane → ℂ) = 0 := by
  have hrow := CuspForm.coe_diamondLinH_and_coe_heckeTLinH_and_coe_heckeULinH_of_hasNebentypus
    M H k ε 0 0 rfl (hasNebentypus_zero ε)
  rw [hrow.1 d]
  simp

/-- **Zone H**, third component, at `q = M` when `M` is prime: the underlying function of
`heckeULinH k q` on the zero `Γ_H(M)`-form is `ModularForm.heckeU k q` applied to `0`. -/
theorem zoneH_heckeU_zero (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ) (k : ℤ)
    (ε : DirichletCharacter ℂ M) {q : ℕ} (hq : q.Prime) (hqM : q ∣ M) :
    (⇑(CuspForm.heckeULinH k q (0 : CuspForm (CohCarrier.GammaH M H) k)) :
        UpperHalfPlane → ℂ) = ModularForm.heckeU k q ⇑(0 : CuspForm (CohCarrier.GammaH M H) k) := by
  have hrow := CuspForm.coe_diamondLinH_and_coe_heckeTLinH_and_coe_heckeULinH_of_hasNebentypus
    M H k ε 0 0 rfl (hasNebentypus_zero ε)
  exact hrow.2.2 q hq hqM

/-! ## Zone I: the `Γ_H`-nebentypus decomposition -/

/-- **Zone I**, both conjuncts consumed at `f = 0`. The decomposition half produces the finite
index set `s` and the components `fε`; the independence half is then applied *to those very
components* (its slash hypothesis is the one the decomposition half guarantees) to conclude that
each component vanishes. The composite statement --- that the zero form decomposes into a finite
family of vanishing `ε`-components --- is not either half alone. -/
theorem zoneI_decomp_zero (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ) (k : ℤ) :
    ∃ (s : Finset (DirichletCharacter ℂ M))
      (fε : DirichletCharacter ℂ M → CuspForm (CohCarrier.GammaH M H) k),
      (∀ ε ∈ s, ∀ d : (ZMod M)ˣ, d ∈ H → ε (d : ZMod M) = 1) ∧
      (∀ ε ∈ s, fε ε = 0) ∧
      (⇑(0 : CuspForm (CohCarrier.GammaH M H) k) : UpperHalfPlane → ℂ) = ∑ ε ∈ s, ⇑(fε ε) := by
  obtain ⟨hdecomp, hindep⟩ :=
    CuspForm.exists_finset_dirichlet_sum_eq_and_independent_of_gammaH M H k
  obtain ⟨s, fε, hH, hslash, hsum⟩ := hdecomp (0 : CuspForm (CohCarrier.GammaH M H) k)
  refine ⟨s, fε, hH, fun ε hε => ?_, hsum⟩
  refine hindep s fε hslash ?_ ε hε
  rw [← hsum, FunLike.coe_zero]

end SetAF65BConsumer
