      * ((qExpansion 1 (h₁ : ℍ → ℂ) : PowerSeries ℂ) : LaurentSeries ℂ)
        ^ Nat.card (𝒮ℒ ⧸ 𝒢.subgroupOf 𝒮ℒ) ≠ 0 :=
    mul_ne_zero (pow_ne_zero _ hΔL) (pow_ne_zero _ hH1Lne)
  have hsum0 : ∑ r : Fin (Nat.card (𝒮ℒ ⧸ 𝒢.subgroupOf 𝒮ℒ) + 1),
