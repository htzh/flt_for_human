    have hALn_ne : ((qExpansion 1
        (Aform g₁ h₁ (Nat.card (𝒮ℒ ⧸ 𝒢.subgroupOf 𝒮ℒ)) : ℍ → ℂ) : PowerSeries ℂ) :
        LaurentSeries ℂ) ≠ 0 := by
      rw [Ne, ← PowerSeries.coe_zero]
