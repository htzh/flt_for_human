    rw [hP r]
    have hr : (r : ℕ) ≤ Nat.card (𝒮ℒ ⧸ 𝒢.subgroupOf 𝒮ℒ) := Nat.lt_succ_iff.mp r.2
    have hexp : ((qExpansion 1 (g₁ : ℍ → ℂ) : PowerSeries ℂ) : LaurentSeries ℂ) ^ (r : ℕ)
