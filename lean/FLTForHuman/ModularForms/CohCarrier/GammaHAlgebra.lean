theorem CohCarrier.index_gammaH_eq_index_gamma0_mul_index (M : ℕ) [NeZero M]
    (H : Subgroup (ZMod M)ˣ) :
    (CohCarrier.GammaH M H).index = (CongruenceSubgroup.Gamma0 M).index * H.index := by
  rw [CohCarrier.GammaH, Subgroup.index_map_subtype (H.comap (gamma0Units M)),
    Subgroup.index_comap_of_surjective (H := H) (igIDX_gamma0Units_surjective M), mul_comm]

