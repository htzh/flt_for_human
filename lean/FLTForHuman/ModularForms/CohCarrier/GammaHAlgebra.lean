open CohCarrier

theorem CohCarrier.H1_moduleFinite (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ) (R : Type*) [CommRing R]
    (A : Type*) [AddCommGroup A] [Module R A] [IsNoetherianRing R] [Module.Finite R A] :
    Module.Finite R (H1 M H A) := by
  have : Group.FG ↥(GammaH M H) := IharaSubgroup.GammaH_fg M H
  obtain ⟨s, hs, hfin⟩ := Group.fg_iff.mp (inferInstance : Group.FG ↥(GammaH M H))
  have : Finite s := hfin.to_subtype
  exact Module.Finite.of_injective (IharaSubgroup.evalAt R A s)
    (IharaSubgroup.evalAt_injective R A hs)

