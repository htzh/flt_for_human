/-
  The Hecke data of the cohomological carrier: a commutative family of
  `𝒪`-linear endomorphisms of a module `V` (a type `Gen` of generators, its
  operators `op`, and the commutativity `comm`), together with a character-like
  assignment `θbar : Gen → k` of eigenvalues in a `k`-algebra `𝒪`.

  From it the module builds the free commutative `𝒪`-algebra `FreeAlg` on the
  generators, the evaluation `thetaTilde` of a free polynomial at `θbar`, its
  kernel `mTheta` (a prime ideal, since `k` is a field), the commutative
  subalgebra `opSubalgebra` of `Module.End 𝒪 V` spanned by the operators, and
  the `𝒪`-algebra map `opAlgHom : FreeAlg →ₐ[𝒪] Module.End 𝒪 V` sending the
  generator `X g` to `op g`. That map makes `V` a `FreeAlg`-module
  (`moduleFreeAlg`, a local instance throughout this module), and
  `algebraMap_freeAlg_smul` records that the `𝒪`-module structure on `V` is the
  restriction of scalars of the `FreeAlg`-one (`V_isScalarTower`).

  The localization `ML` of `V` at the prime complement of `mTheta` is the
  Hecke-localized carrier: `toML` is the localization map, `FreeAlg`-linear,
  and `toMLₒ` is the same map restricted to scalars `𝒪`. This module is what
  `ModularForms/CohCarrier/Inst.lean` feeds with the generator family
  `opFamily` of the cohomological Hecke algebra.

  FLT provenance, pinned `aa2d8b3`:
  https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b3/Definitions/Def_CohCarrier_HeckeData.lean

  Statements are transcribed verbatim (same names, binders and universes); the
  proofs are the pin's, adapted only where mathlib `v4.34.0` moved an API: in
  `opSubalgebra_isMulCommutative`, `Algebra.isMulCommutative_adjoin` now takes
  its hypothesis in `Set.Pairwise Commute` form, so the pin's pointwise
  `D.op_comm_of_mem` is passed as `fun _ ha _ hb _ => D.op_comm_of_mem _ ha _ hb`
  (the same statement, one extra `≠` binder); `op_comm_of_mem` itself stays
  verbatim. The pin's six `example`s (`:64–66`, `:78`, `:80`, `:82`) are
  `inferInstance` probes, not declarations; they are kept as `example`s, which is
  what makes the `attribute [local instance] moduleFreeAlg` load-bearing (the
  `Module D.FreeAlg D.ML` and `IsScalarTower` probes fail without it).

  spec-pin: Definitions/Def_CohCarrier_HeckeData.lean
-/
import Mathlib.Algebra.Module.LocalizedModule.Basic
import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.RingTheory.Ideal.Maps
import Mathlib.Algebra.Algebra.Subalgebra.Lattice

set_option autoImplicit false

noncomputable section

namespace CohCarrier

universe u v w

/-- The Hecke data of the cohomological carrier: a type of generators `Gen`
acting `𝒪`-linearly on `V` by pairwise-commuting endomorphisms `op`, together
with the eigenvalues `θbar` in the `𝒪`-algebra `k`. -/
structure HeckeData (𝒪 : Type u) [CommRing 𝒪] (V : Type v) [AddCommGroup V] [Module 𝒪 V]
    (k : Type w) [Field k] [Algebra 𝒪 k] where

  Gen : Type

  op : Gen → Module.End 𝒪 V

  comm : ∀ g h : Gen, op g * op h = op h * op g

  θbar : Gen → k

namespace HeckeData

variable {𝒪 : Type u} [CommRing 𝒪] {V : Type v} [AddCommGroup V] [Module 𝒪 V]
  {k : Type w} [Field k] [Algebra 𝒪 k] (D : HeckeData 𝒪 V k)

/-- The free commutative `𝒪`-algebra on the generators of the Hecke data. -/
abbrev FreeAlg : Type u := MvPolynomial D.Gen 𝒪

/-- Evaluation of a free polynomial at the eigenvalues `θbar`. -/
noncomputable def thetaTilde : D.FreeAlg →ₐ[𝒪] k := MvPolynomial.aeval D.θbar

/-- The kernel of `thetaTilde`, the ideal the localization `ML` inverts. -/
def mTheta : Ideal D.FreeAlg := RingHom.ker D.thetaTilde.toRingHom

/-- `mTheta` is prime: it is the kernel of a ring map into the field `k`. -/
instance mTheta_isPrime : D.mTheta.IsPrime := RingHom.ker_isPrime _

/-- The commutative `𝒪`-subalgebra of `Module.End 𝒪 V` generated by the
operators `op g`. -/
noncomputable def opSubalgebra : Subalgebra 𝒪 (Module.End 𝒪 V) := Algebra.adjoin 𝒪 (Set.range D.op)

/-- The generators commute, pointwise (the form `comm` is stated in). -/
theorem op_comm_of_mem : ∀ a ∈ Set.range D.op, ∀ b ∈ Set.range D.op, a * b = b * a := by
  rintro _ ⟨g, rfl⟩ _ ⟨h, rfl⟩
  exact D.comm g h

/-- `opSubalgebra` is commutative, being generated by a commuting set. -/
instance opSubalgebra_isMulCommutative : IsMulCommutative ↥D.opSubalgebra :=
  Algebra.isMulCommutative_adjoin 𝒪 fun _ ha _ hb _ => D.op_comm_of_mem _ ha _ hb

open scoped IsMulCommutative

/-- The `𝒪`-algebra map from the free algebra to `Module.End 𝒪 V` sending the
generator `X g` to `op g`. -/
noncomputable def opAlgHom : D.FreeAlg →ₐ[𝒪] Module.End 𝒪 V :=
  (D.opSubalgebra.val).comp
    (MvPolynomial.aeval fun g => (⟨D.op g, Algebra.subset_adjoin (Set.mem_range_self g)⟩ :
      ↥D.opSubalgebra))

/-- `opAlgHom` sends the generator `X g` to `op g`. -/
@[simp] theorem opAlgHom_X (g : D.Gen) : D.opAlgHom (MvPolynomial.X g) = D.op g := by
  simp [opAlgHom]

/-- `V` as a module over the free algebra, through `opAlgHom`. This is the
structure all the `FreeAlg`-linearity below refers to; it is made a *local*
instance (`attribute [local instance] moduleFreeAlg`) so that it does not leak
past this module. -/
@[reducible] noncomputable def moduleFreeAlg : Module D.FreeAlg V :=
  Module.compHom V D.opAlgHom.toRingHom

attribute [local instance] moduleFreeAlg

/-- The Hecke localization of `V`: the localization of the `FreeAlg`-module `V`
at the prime complement of `mTheta`. -/
noncomputable abbrev ML : Type (max u v) := LocalizedModule D.mTheta.primeCompl V

example : AddCommGroup D.ML := inferInstance
example : Module (Localization D.mTheta.primeCompl) D.ML := inferInstance
example : Module D.FreeAlg D.ML := inferInstance

/-- The localization map `V → ML`, `FreeAlg`-linear. -/
noncomputable def toML : V →ₗ[D.FreeAlg] D.ML := LocalizedModule.mkLinearMap D.mTheta.primeCompl V

/-- The `𝒪`-action on `V` agrees with the action through the algebra map
`𝒪 → FreeAlg`: the `FreeAlg`-module structure restricts to the given
`𝒪`-module structure. -/
theorem algebraMap_freeAlg_smul (r : 𝒪) (v : V) : (algebraMap 𝒪 D.FreeAlg r) • v = r • v := by
  show D.opAlgHom (algebraMap 𝒪 D.FreeAlg r) v = r • v
  rw [AlgHom.commutes]
  rfl

/-- `V` is an `𝒪`-`FreeAlg`-scalar tower. -/
instance V_isScalarTower : IsScalarTower 𝒪 D.FreeAlg V :=
  ⟨fun r a v => by rw [Algebra.smul_def, mul_smul, algebraMap_freeAlg_smul]⟩

example : Module 𝒪 D.ML := inferInstance

example : IsScalarTower 𝒪 (Localization D.mTheta.primeCompl) D.ML := inferInstance

example : IsScalarTower 𝒪 D.FreeAlg D.ML := inferInstance

/-- The localization map `V → ML` restricted to scalars `𝒪`, `𝒪`-linear. -/
noncomputable def toMLₒ : V →ₗ[𝒪] D.ML := D.toML.restrictScalars 𝒪

/-- `toMLₒ` is `toML` on elements. -/
@[simp] theorem toMLₒ_apply (v : V) : D.toMLₒ v = D.toML v := rfl

end HeckeData

end CohCarrier

end
