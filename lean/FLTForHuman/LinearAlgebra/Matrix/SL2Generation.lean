  spec-pin: Theorems/Thm_Matrix_SpecialLinearGroup_closure_diagonal_unipotent_weyl_eq_top.lean
  spec-pin: P2M/Sol/S_Matrix_SpecialLinearGroup_closure_diagonal_unipotent_weyl_eq_top.lean
-/

import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.LinearCombination

open scoped MatrixGroups

set_option autoImplicit false

namespace Matrix

namespace SpecialLinearGroup

namespace BruhatGeneration

variable {K : Type*} [Field K] {G : Type*} [Group G]

/-- The diagonal element `diag(a, a⁻¹)` of `SL(2, K)`, for `a ≠ 0`. -/
private def dk (a : K) (_ : a ≠ 0) : SL(2, K) :=
  ⟨!![a, 0; 0, a⁻¹], by simp [Matrix.det_fin_two_of, mul_inv_cancel₀ ‹a ≠ 0›]⟩

/-- The upper unipotent element `!![1, z; 0, 1]` of `SL(2, K)`. -/
private def nk (z : K) : SL(2, K) :=
  ⟨!![1, z; 0, 1], by simp [Matrix.det_fin_two_of]⟩

/-- The Weyl element `!![0, 1; -1, 0]` of `SL(2, K)`. -/
private def wk : SL(2, K) :=
  ⟨!![0, 1; -1, 0], by simp [Matrix.det_fin_two_of]⟩

/-- The pin's generator set: the diagonal torus, the upper unipotent subgroup and the Weyl
element, as a set of elements of `SL(2, K)`. -/
private def genSet : Set (SL(2, K)) :=
  ({g : SL(2, K) | ∃ a : K, (g : Matrix (Fin 2) (Fin 2) K) = !![a, 0; 0, a⁻¹]} ∪
    {g : SL(2, K) | ∃ z : K, (g : Matrix (Fin 2) (Fin 2) K) = !![1, z; 0, 1]} ∪
    {g : SL(2, K) | (g : Matrix (Fin 2) (Fin 2) K) = !![0, 1; -1, 0]})

private theorem dk_mem (a : K) (h : a ≠ 0) : dk a h ∈ genSet (K := K) :=
  Or.inl (Or.inl ⟨a, rfl⟩)

private theorem nk_mem (z : K) : nk z ∈ genSet (K := K) :=
  Or.inl (Or.inr ⟨z, rfl⟩)

private theorem wk_mem : (wk : SL(2, K)) ∈ genSet (K := K) :=
  Or.inr rfl

/-- The Bruhat case analysis: every `g ∈ SL(2, K)` is a product of elements of
`genSet`, so the closure of `genSet` is everything. -/
private theorem closure_eq_top :
    Subgroup.closure
      ({g : SL(2, K) | ∃ a : K, (g : Matrix (Fin 2) (Fin 2) K) = !![a, 0; 0, a⁻¹]} ∪
        {g : SL(2, K) | ∃ z : K, (g : Matrix (Fin 2) (Fin 2) K) = !![1, z; 0, 1]} ∪
        {g : SL(2, K) | (g : Matrix (Fin 2) (Fin 2) K) = !![0, 1; -1, 0]}) = ⊤ := by
  show Subgroup.closure (genSet (K := K)) = ⊤
  rw [Subgroup.eq_top_iff']
  intro g
  induction g using Matrix.SpecialLinearGroup.fin_two_induction with
  | _ a b c d hdet =>
    by_cases hc : c = 0
    · have h1 : a * d = 1 := by simpa [hc] using hdet
      have ha : a ≠ 0 := left_ne_zero_of_mul_eq_one h1
      have hd : d = a⁻¹ := (inv_eq_of_mul_eq_one_right h1).symm
      have hmem : nk (a * b) * dk a ha ∈ Subgroup.closure (genSet (K := K)) :=
        mul_mem (Subgroup.subset_closure (nk_mem _)) (Subgroup.subset_closure (dk_mem a ha))
      set P : SL(2, K) := nk (a * b) * dk a ha with hP
      have heq : (⟨!![a, b; c, d], by rw [Matrix.det_fin_two_of]; exact hdet⟩ : SL(2, K)) = P := by
        refine Subtype.ext ?_
        rw [hP]
        rw [Matrix.SpecialLinearGroup.coe_mul]
        simp [nk, dk, hc, hd, mul_assoc]
        field_simp
      rw [heq]
      exact hmem
    · have hc' : c ≠ 0 := hc
      have hcinv : (-c⁻¹ : K) ≠ 0 := neg_ne_zero.mpr (inv_ne_zero hc)
      have hmem : nk (a / c) * dk (-c⁻¹) hcinv * wk * nk (d / c) ∈
          Subgroup.closure (genSet (K := K)) :=
        mul_mem
          (mul_mem
            (mul_mem (Subgroup.subset_closure (nk_mem _))
              (Subgroup.subset_closure (dk_mem _ hcinv)))
            (Subgroup.subset_closure wk_mem))
          (Subgroup.subset_closure (nk_mem _))
      set P : SL(2, K) := nk (a / c) * dk (-c⁻¹) hcinv * wk * nk (d / c) with hP
      have heq : (⟨!![a, b; c, d], by rw [Matrix.det_fin_two_of]; exact hdet⟩ : SL(2, K)) = P := by
        refine Subtype.ext ?_
        rw [hP]
        rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.coe_mul,
          Matrix.SpecialLinearGroup.coe_mul]
        simp [nk, dk, wk, inv_neg, inv_inv, mul_assoc]
        field_simp
        simp only [true_and, and_true]
        linear_combination -hdet
      rw [heq]
      exact hmem

end BruhatGeneration

/-- The pin's headline: `SL(2, K)` is generated by the diagonal, the upper unipotent
subgroup and the Weyl element, at the wrapper's name. -/
theorem closure_diagonal_unipotent_weyl_eq_top
    {K : Type*} [Field K] :
    Subgroup.closure
      ({g : SL(2, K) | ∃ a : K, (g : Matrix (Fin 2) (Fin 2) K) = !![a, 0; 0, a⁻¹]} ∪
        {g : SL(2, K) | ∃ z : K, (g : Matrix (Fin 2) (Fin 2) K) = !![1, z; 0, 1]} ∪
        {g : SL(2, K) | (g : Matrix (Fin 2) (Fin 2) K) = !![0, 1; -1, 0]}) = ⊤ :=
  BruhatGeneration.closure_eq_top

end SpecialLinearGroup

end Matrix
