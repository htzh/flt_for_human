  (∃ D : TreeIsogenyEndDatum E.toAffine, D.degree = N) →
    ∃ (K₀ : IntermediateField ℚ K) (_ : Countable K₀)
      (E₀ : WeierstrassCurve K₀) (_ : E₀.IsElliptic) (_ : E₀.map (algebraMap K₀ K) = E)
      (D₀ : TreeIsogenyEndDatum (E₀⁄(AlgebraicClosure K₀))), D₀.degree = N

