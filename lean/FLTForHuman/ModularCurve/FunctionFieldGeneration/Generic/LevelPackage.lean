/-
  The level-degree package at a general base field.

  `baseField jg` is the field the j-series generates (`jg = j(q)`), `levelSeries jg N` is
  `j(q ^ N)`, and `levelField jg N` is the field it generates over the base. `PkgAt jg M` is the
  package the strong induction runs on: at every `d ∣ M`, the level-`d` field has `finrank` `ψ(d)`
  over the base and is generated by the level series at the divisors of `d`.

  This is the hypothesis half of T19, at a general coefficient field: nothing here knows about
  `ℚ`. The `ℚ` package (`Tight`, `Gen`, `Hall`) is the same predicate written in `ℚ` vocabulary,
  and the conversion is a separate, later layer.

  The package's two clauses are named (`degreeAt`, `generatedAt`), which is also the `ℚ` layer's
  split into `Tight` and `Gen`; the two consequences below take the degree clause alone, because
  that is all they spend.

  The two proofs are the `ℚ` ones of `Defs/Invariants.lean` with `degreeAt` supplying the finrank
  identity they were stated from.
-/
import FLTForHuman.ModularCurve.Defs.Laurent
import FLTForHuman.NumberTheory.DedekindPsi

set_option autoImplicit false

noncomputable section

open Polynomial HahnSeries IntermediateField
open scoped IntermediateField

namespace ModularCurve

variable {κ : Type*} [Field κ]

/-- The level series `j(q ^ N)`, read in the coefficient field `κ`. -/
def levelSeries (jg : LaurentSeries κ) (N : ℕ) [NeZero N] : LaurentSeries κ := qExpand κ N jg

/-- The base field: the field generated by the j-series. It is derived, never a parameter — both
instances of the theory have exactly this base field, and deriving it is what keeps the package
from drifting to the working field. -/
abbrev baseField (jg : LaurentSeries κ) : IntermediateField κ (LaurentSeries κ) :=
  IntermediateField.adjoin κ ({jg} : Set (LaurentSeries κ))

/-- The level-`N` field over the base: the field the level series generates. -/
abbrev levelField (jg : LaurentSeries κ) (N : ℕ) [NeZero N] :
    IntermediateField (baseField jg) (LaurentSeries κ) :=
  IntermediateField.adjoin (baseField jg) ({levelSeries jg N} : Set (LaurentSeries κ))

/-- **The degree clause**: the level-`d` field has `finrank` `ψ(d)` over the base. The package's
first half, named — it is the hypothesis of both consequences below, and at `ℚ` it is `Tight`. -/
abbrev degreeAt (jg : LaurentSeries κ) (d : ℕ) [NeZero d] : Prop :=
  Module.finrank (baseField jg) (levelField jg d) = dedekindPsi d

/-- **The generation clause**: adjoining the level-`d` series generates the level series at the
divisors of `d`. The package's second half, named — at `ℚ` it is `Gen`.

Stated over the coefficient field, i.e. in the *absolute* spelling: that is the one an instance
proves (`Gen` is `adjoin ℚ {jq, jqN d} = adjoin ℚ (divisors)`), and the relative spelling over
`baseField jg` — `levelField jg d = adjoin (baseField jg) (…)` — is `coe_adjoin_baseField` away.
Spelling it relatively here would force every instance to make that base change itself, through an
`IsScalarTower` instance that `restrictScalars` cannot find at the shape it is applied to. -/
abbrev generatedAt (jg : LaurentSeries κ) (d : ℕ) [NeZero d] : Prop :=
  IntermediateField.adjoin κ ({jg} ∪ {levelSeries jg d})
    = IntermediateField.adjoin κ
        ({jg} ∪ {x : LaurentSeries κ | ∃ (d' : ℕ) (_ : NeZero d'), d' ∣ d ∧ x = levelSeries jg d'})

/-- **The one relative/absolute conversion**: adjoining over the base field is adjoining over the
coefficient field together with the j-series. Stated as an identity of carrier sets, so it rewrites
inside `∈` as well as under `=`; this is what a consumer of `generatedAt` who wants `levelField`
needs, and it is stated once, here, rather than per instance. -/
theorem coe_adjoin_baseField (jg : LaurentSeries κ) (T : Set (LaurentSeries κ)) :
    ((IntermediateField.adjoin (baseField jg) T :
        IntermediateField (baseField jg) (LaurentSeries κ)) : Set (LaurentSeries κ))
      = (IntermediateField.adjoin κ ({jg} ∪ T) : Set (LaurentSeries κ)) := by
  have h := restrictScalars_adjoin (F := κ) (baseField jg) T
  have h2 := congrArg (fun E : IntermediateField κ (LaurentSeries κ) =>
    (E : Set (LaurentSeries κ))) h
  rw [coe_restrictScalars] at h2
  rw [h2, baseField, adjoin_union, adjoin_union, adjoin_self]

/-- **The level-degree package**: both clauses at every `d ∣ M`. -/
abbrev PkgAt (jg : LaurentSeries κ) (M : ℕ) : Prop :=
  ∀ d : ℕ, d ∣ M → ∀ [NeZero d], degreeAt jg d ∧ generatedAt jg d

/-- **Integrality of the level series**: the degree clause at `M` gives the adjoin the finite
dimension `ψ(M)`, so the level series is integral over the base. The hypothesis is that clause
alone, not the whole package: integrality spends nothing else, and a caller holding `PkgAt` projects
it in one step. -/
theorem isIntegral_levelSeries (jg : LaurentSeries κ) (M : ℕ) [NeZero M]
    (hf : degreeAt jg M) :
    IsIntegral (baseField jg) (levelSeries jg M) := by
  have hfd : FiniteDimensional (baseField jg) (levelField jg M) :=
    FiniteDimensional.of_finrank_pos (hf ▸ dedekindPsi_pos M (NeZero.ne M))
  exact IntermediateField.isIntegral_iff.mp
    (IsIntegral.of_finite (baseField jg)
      (⟨levelSeries jg M,
        IntermediateField.subset_adjoin (baseField jg) ({levelSeries jg M} : Set (LaurentSeries κ))
          rfl⟩ : levelField jg M))

/-- **The degree of the minimal polynomial**: `minpoly` of the level series over the base has the
degree of the adjoin, `ψ(M)` — again from the degree clause alone. -/
theorem natDegree_minpoly_levelSeries (jg : LaurentSeries κ) (M : ℕ) [NeZero M]
    (hf : degreeAt jg M) :
    (minpoly (baseField jg) (levelSeries jg M)).natDegree = dedekindPsi M := by
  rw [← IntermediateField.adjoin.finrank (isIntegral_levelSeries jg M hf)]
  exact hf

end ModularCurve
