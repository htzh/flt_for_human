/-! ### Extending a parabolic hom along `Γ ↪ Γ ⊔ ⟨-1⟩` -/

namespace ParabolicSupNegOne

open ModularCurve.Period

variable {Γ : Subgroup SL(2, ℤ)}

/-- The extension `Γ ⊔ ⟨-1⟩` of `Γ` by the central element `-1`. -/
private abbrev supNegOne (Γ : Subgroup SL(2, ℤ)) : Subgroup SL(2, ℤ) :=
  Γ ⊔ Subgroup.zpowers (-1 : SL(2, ℤ))

private theorem neg_one_mem_supNegOne : (-1 : SL(2, ℤ)) ∈ supNegOne Γ :=
  Subgroup.mem_sup_right (Subgroup.mem_zpowers _)

private theorem mem_supNegOne_of_mem {g : SL(2, ℤ)} (hg : g ∈ Γ) : g ∈ supNegOne Γ :=
  Subgroup.mem_sup_left hg

/-- `⟨-1⟩` is normal in `SL(2, ℤ)`, being contained in the centre. -/
private instance zpowers_neg_one_normal : (Subgroup.zpowers (-1 : SL(2, ℤ))).Normal :=
  ⟨fun n hn g => by
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hn
    have hc : Commute g ((-1 : SL(2, ℤ)) ^ k) := (Commute.neg_one_right g).zpow_right k
    rw [hc.eq, mul_inv_cancel_right]
    exact Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) k⟩

/-- Every element of `Γ ⊔ ⟨-1⟩` is `γ` or `-γ` for some `γ ∈ Γ`. -/
private theorem exists_of_mem_supNegOne {g : SL(2, ℤ)} (hg : g ∈ supNegOne Γ) :
    ∃ γ : SL(2, ℤ), γ ∈ Γ ∧ (g = γ ∨ g = -γ) := by
  obtain ⟨y, hy, z, hz, rfl⟩ := Subgroup.mem_sup_of_normal_right.mp hg
  obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hz
  refine ⟨y, hy, ?_⟩
  rcases Int.even_or_odd k with ⟨m, rfl⟩ | ⟨m, rfl⟩
  · left
    have : ((-1 : SL(2, ℤ)) ^ (2 : ℤ)) = 1 := by rw [zpow_two]; simp
    rw [← two_mul, zpow_mul, this, one_zpow, mul_one]
  · right
    have : ((-1 : SL(2, ℤ)) ^ (2 : ℤ)) = 1 := by rw [zpow_two]; simp
    rw [zpow_add, zpow_mul, this, one_zpow, one_mul, zpow_one, mul_neg_one]

/-- Negation preserves the square of the trace. -/
private theorem trace_neg_sq (γ : SL(2, ℤ)) :
    (((-γ : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ).trace) ^ 2 =
      ((γ : Matrix (Fin 2) (Fin 2) ℤ).trace) ^ 2 := by
  rw [Matrix.SpecialLinearGroup.coe_neg, Matrix.trace_neg, neg_sq]

private theorem trace_neg_one_sq : (((-1 : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ).trace) ^ 2 = 4 := by
  rw [trace_neg_sq]; simp

section Parabolic

variable {A : Type*} [AddCommGroup A] {ψ : Additive Γ →+ A}

private theorem apply_neg_one (hψ : IsParabolicHom Γ ψ) (h : (-1 : SL(2, ℤ)) ∈ Γ) :
    ψ (Additive.ofMul ⟨-1, h⟩) = 0 :=
  hψ ⟨-1, h⟩ trace_neg_one_sq

/-- A parabolic hom takes the same value on `γ` and on `-γ`. -/
private theorem apply_eq_of_eq_or_eq_neg (hψ : IsParabolicHom Γ ψ) {γ δ : SL(2, ℤ)}
    (hγ : γ ∈ Γ) (hδ : δ ∈ Γ) (h : γ = δ ∨ γ = -δ) :
    ψ (Additive.ofMul ⟨γ, hγ⟩) = ψ (Additive.ofMul ⟨δ, hδ⟩) := by
  rcases h with rfl | rfl
  · rfl
  · have hm : (-1 : SL(2, ℤ)) ∈ Γ := by
      have := Γ.mul_mem hγ (Γ.inv_mem hδ)
      simpa using this
    have hprod : (⟨-δ, hγ⟩ : Γ) = ⟨-1, hm⟩ * ⟨δ, hδ⟩ := Subtype.ext (by simp)
    rw [hprod, ofMul_mul, map_add, apply_neg_one hψ hm, zero_add]

/-- A choice of representative in `Γ` of a coset of `Γ` modulo `⟨-1⟩`. -/
private def rep (g : ↥(supNegOne Γ)) : SL(2, ℤ) := (exists_of_mem_supNegOne g.2).choose

private theorem rep_mem (g : ↥(supNegOne Γ)) : rep g ∈ Γ :=
  (exists_of_mem_supNegOne g.2).choose_spec.1

private theorem eq_or_eq_neg_rep (g : ↥(supNegOne Γ)) :
    (g : SL(2, ℤ)) = rep g ∨ (g : SL(2, ℤ)) = -rep g :=
  (exists_of_mem_supNegOne g.2).choose_spec.2

/-- The candidate extension: evaluate `ψ` at the chosen representative. -/
private def extFun (ψ : Additive Γ →+ A) (g : ↥(supNegOne Γ)) : A :=
  ψ (Additive.ofMul ⟨rep g, rep_mem g⟩)

private theorem extFun_eq (hψ : IsParabolicHom Γ ψ) (g : ↥(supNegOne Γ)) {γ : SL(2, ℤ)}
    (hγ : γ ∈ Γ) (h : (g : SL(2, ℤ)) = γ ∨ (g : SL(2, ℤ)) = -γ) :
    extFun ψ g = ψ (Additive.ofMul ⟨γ, hγ⟩) := by
  unfold extFun
  apply apply_eq_of_eq_or_eq_neg hψ
  rcases eq_or_eq_neg_rep g with h1 | h1 <;> rcases h with h2 | h2
  · exact Or.inl (h1.symm.trans h2)
  · exact Or.inr (h1.symm.trans h2)
  · exact Or.inr (by rw [← neg_eq_iff_eq_neg.mpr h1, h2])
  · exact Or.inl (by have := h1.symm.trans h2; exact neg_injective this)

/-- The extension of `ψ` to `Γ ⊔ ⟨-1⟩`. -/
private def extHom (ψ : Additive Γ →+ A) (hψ : IsParabolicHom Γ ψ) :
    Additive ↥(supNegOne Γ) →+ A where
  toFun g := extFun ψ (Additive.toMul g)
  map_zero' := by
    show extFun ψ (1 : ↥(supNegOne Γ)) = 0
    rw [extFun_eq hψ (1 : ↥(supNegOne Γ)) Γ.one_mem (Or.inl rfl)]
    exact map_zero ψ
  map_add' x y := by
    show extFun ψ (Additive.toMul x * Additive.toMul y)
      = extFun ψ (Additive.toMul x) + extFun ψ (Additive.toMul y)
    set g := Additive.toMul x
    set g' := Additive.toMul y
    have hgg : ((g * g' : ↥(supNegOne Γ)) : SL(2, ℤ)) = rep g * rep g' ∨
        ((g * g' : ↥(supNegOne Γ)) : SL(2, ℤ)) = -(rep g * rep g') := by
      rw [Subgroup.coe_mul]
      rcases eq_or_eq_neg_rep g with h1 | h1 <;> rcases eq_or_eq_neg_rep g' with h2 | h2 <;>
        rw [h1, h2]
      · exact Or.inl rfl
      · exact Or.inr (by simp)
      · exact Or.inr (by simp)
      · exact Or.inl (by simp)
    rw [extFun_eq hψ (g * g') (Γ.mul_mem (rep_mem g) (rep_mem g')) hgg]
    have : (⟨rep g * rep g', Γ.mul_mem (rep_mem g) (rep_mem g')⟩ : Γ) =
        ⟨rep g, rep_mem g⟩ * ⟨rep g', rep_mem g'⟩ := rfl
    rw [this, ofMul_mul, map_add]
    rfl

private theorem extHom_apply_of_mem (ψ : Additive Γ →+ A) (hψ : IsParabolicHom Γ ψ) (γ : Γ) :
    extHom ψ hψ (Additive.ofMul ⟨(γ : SL(2, ℤ)), mem_supNegOne_of_mem γ.2⟩)
      = ψ (Additive.ofMul γ) :=
  extFun_eq hψ _ γ.2 (Or.inl rfl)

private theorem isParabolicHom_extHom (ψ : Additive Γ →+ A) (hψ : IsParabolicHom Γ ψ) :
    IsParabolicHom (supNegOne Γ) (extHom ψ hψ) := by
  intro g hg
  show extFun ψ g = 0
  rw [extFun]
  apply hψ
  rcases eq_or_eq_neg_rep g with h | h
  · simpa [h] using hg
  · have : (((g : SL(2, ℤ))) : Matrix (Fin 2) (Fin 2) ℤ).trace ^ 2 =
        ((rep g : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ).trace ^ 2 := by
      rw [h, trace_neg_sq]
    rw [← this]; exact hg

private theorem unique_extHom (ψ : Additive Γ →+ A) (hψ : IsParabolicHom Γ ψ)
    (φ : Additive ↥(supNegOne Γ) →+ A) (hφ : IsParabolicHom (supNegOne Γ) φ)
    (hφψ : ∀ γ : Γ, φ (Additive.ofMul ⟨(γ : SL(2, ℤ)), mem_supNegOne_of_mem γ.2⟩)
      = ψ (Additive.ofMul γ)) :
    φ = extHom ψ hψ := by
  ext x
  set g := Additive.toMul x
  show φ (Additive.ofMul g) = extHom ψ hψ (Additive.ofMul g)
  have hm1 : φ (Additive.ofMul ⟨-1, neg_one_mem_supNegOne⟩) = 0 :=
    hφ ⟨-1, neg_one_mem_supNegOne⟩ trace_neg_one_sq
  rcases eq_or_eq_neg_rep g with h | h
  · have hg : g = ⟨rep g, mem_supNegOne_of_mem (rep_mem g)⟩ := Subtype.ext h
    rw [hg, hφψ ⟨rep g, rep_mem g⟩]
    exact (extFun_eq hψ (⟨rep g, mem_supNegOne_of_mem (rep_mem g)⟩ : ↥(supNegOne Γ))
      (rep_mem g) (Or.inl rfl)).symm
  · have hg : g = ⟨-1, neg_one_mem_supNegOne⟩ *
        ⟨rep g, mem_supNegOne_of_mem (rep_mem g)⟩ :=
      Subtype.ext (by rw [h]; simp)
    rw [hg, ofMul_mul, map_add, map_add, hm1, zero_add, hφψ ⟨rep g, rep_mem g⟩]
    have e1 : extHom ψ hψ (Additive.ofMul (⟨rep g, mem_supNegOne_of_mem (rep_mem g)⟩ : ↥(supNegOne Γ))) =
        ψ (Additive.ofMul ⟨rep g, rep_mem g⟩) :=
      extFun_eq hψ (⟨rep g, mem_supNegOne_of_mem (rep_mem g)⟩ : ↥(supNegOne Γ))
        (rep_mem g) (Or.inl rfl)
    have e2 : extHom ψ hψ (Additive.ofMul (⟨-1, neg_one_mem_supNegOne⟩ : ↥(supNegOne Γ))) =
        ψ (Additive.ofMul ⟨1, Γ.one_mem⟩) :=
      extFun_eq hψ (⟨-1, neg_one_mem_supNegOne⟩ : ↥(supNegOne Γ)) Γ.one_mem (Or.inr (by simp))
    rw [e1, e2]
    have : (⟨1, Γ.one_mem⟩ : Γ) = 1 := rfl
    rw [this, ofMul_one, map_zero, zero_add]

end Parabolic

end ParabolicSupNegOne

/-- **The `±1` extension of a parabolic hom.** A parabolic hom `Γ →+ A` extends
uniquely to a parabolic hom on `Γ ⊔ ⟨-1⟩`, agreeing with it on `Γ`. -/
theorem ModularCurve.Period.existsUnique_isParabolicHom_sup_zpowers_neg_one_apply_eq
    (Γ : Subgroup SL(2, ℤ)) (A : Type*) [AddCommGroup A] (ψ : Additive Γ →+ A)
    (hψ : ModularCurve.Period.IsParabolicHom Γ ψ) :
    ∃! φ : Additive ↥(Γ ⊔ Subgroup.zpowers (-1 : SL(2, ℤ))) →+ A,
      ModularCurve.Period.IsParabolicHom (Γ ⊔ Subgroup.zpowers (-1 : SL(2, ℤ))) φ ∧
        ∀ γ : Γ, φ (Additive.ofMul ⟨(γ : SL(2, ℤ)), Subgroup.mem_sup_left γ.2⟩) = ψ (Additive.ofMul γ) := by
  refine ⟨ParabolicSupNegOne.extHom ψ hψ,
    ⟨ParabolicSupNegOne.isParabolicHom_extHom ψ hψ,
      ParabolicSupNegOne.extHom_apply_of_mem ψ hψ⟩, ?_⟩
  rintro φ ⟨hφ, hφψ⟩
  exact ParabolicSupNegOne.unique_extHom ψ hψ φ hφ hφψ

/-! ### A nowhere-zero invariant function is the exponential of a primitive -/

namespace ModularCurve

namespace WindingLog

open UpperHalfPlane Filter Complex Set Topology

private theorem eq_zero_of_exp_eq_one_of_norm_lt {D : ℂ} (h1 : Complex.exp D = 1)
    (h2 : ‖D‖ < 2 * π) : D = 0 := by
  obtain ⟨k, hk⟩ := Complex.exp_eq_one_iff.1 h1
  rw [hk] at h2 ⊢
  have hnorm : ‖(k : ℂ) * (2 * π * Complex.I)‖ = |(k : ℝ)| * (2 * π) := by
    rw [norm_mul, Complex.norm_intCast]
    congr 1
    simp
  rw [hnorm] at h2
  have hk0 : |(k : ℝ)| < 1 := by
    by_contra h
    push Not at h
    have := mul_le_mul_of_nonneg_right h (by positivity : (0 : ℝ) ≤ 2 * π)
    linarith
  have : k = 0 := by
    have : |(k : ℝ)| = |((k : ℤ) : ℝ)| := rfl
    have h' : |(k : ℤ)| < 1 := by exact_mod_cast hk0
    exact Int.abs_lt_one_iff.1 h'
  simp [this]

/-- A continuous `D` with `exp D = 1` is constant on a preconnected space. -/
private theorem apply_eq_of_exp_eq_one {X : Type*} [TopologicalSpace X] [PreconnectedSpace X]
    {D : X → ℂ} (hD : Continuous D) (h1 : ∀ x, Complex.exp (D x) = 1) (x y : X) :
    D x = D y := by
  have hlc : IsLocallyConstant D := by
    rw [IsLocallyConstant.iff_eventually_eq]
    intro x
    have hev : ∀ᶠ y in 𝓝 x, ‖D y - D x‖ < 2 * π := by
      have := (hD.continuousAt (x := x)).sub_const (D x)
      have h0 : ‖D x - D x‖ < 2 * π := by simp [Real.pi_pos]
      exact (this.norm.eventually (gt_mem_nhds h0))
    filter_upwards [hev] with y hy
    have h1' : Complex.exp (D y - D x) = 1 := by
      rw [Complex.exp_sub, h1, h1, div_one]
    exact sub_eq_zero.1 (eq_zero_of_exp_eq_one_of_norm_lt h1' hy)
  exact hlc.apply_eq_of_isPreconnected isPreconnected_univ (mem_univ x) (mem_univ y)

section Lift

private theorem exists_lift (Φ : ℂ → ℂ) (hΦc : ∀ τ : ℍ, ContinuousAt Φ τ)
    (hne : ∀ τ : ℍ, Φ τ ≠ 0) : ∃ L₀ : C(ℍ, ℂ), ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ := by
  set toUnits : C(ℍ, {z : ℂ // z ≠ 0}) :=
    ⟨fun τ => ⟨Φ τ, hne τ⟩, by
      refine Continuous.subtype_mk ?_ _
      exact continuous_iff_continuousAt.2 fun τ => (hΦc τ).comp continuous_coe.continuousAt⟩
    with htoUnits
  have he : (⟨Complex.exp (Complex.log (Φ UpperHalfPlane.I)), Complex.exp_ne_zero _⟩ :
      {z : ℂ // z ≠ 0}) = toUnits UpperHalfPlane.I := by
    apply Subtype.ext
    show Complex.exp (Complex.log (Φ _)) = Φ _
    exact Complex.exp_log (hne _)
  obtain ⟨F, ⟨-, hF⟩, -⟩ := IsCoveringMap.existsUnique_continuousMap_lifts Complex.isCoveringMap_exp
    toUnits UpperHalfPlane.I (Complex.log (Φ UpperHalfPlane.I)) he
  refine ⟨F, fun τ => ?_⟩
  have := congrFun hF τ
  simp only [Function.comp] at this
  exact congrArg Subtype.val this

end Lift

section Local

private theorem eventuallyEq_log {Φ L : ℂ → ℂ} {τ : ℍ} (hΦ : ContinuousAt Φ (τ : ℂ))
    (hne : Φ τ ≠ 0) (hLc : ContinuousAt L (τ : ℂ))
    (hexp : ∀ᶠ z in 𝓝 (τ : ℂ), Complex.exp (L z) = Φ z) :
    L =ᶠ[𝓝 (τ : ℂ)] fun z => L τ + Complex.log (Φ z * (Φ τ)⁻¹) := by
  set ℓ : ℂ → ℂ := fun z => Complex.log (Φ z * (Φ τ)⁻¹) with hℓ
  have hℓτ : ℓ τ = 0 := by simp [hℓ, mul_inv_cancel₀ hne]
  have hℓc : ContinuousAt ℓ (τ : ℂ) := by
    have h1 : ContinuousAt (fun z => Φ z * (Φ τ)⁻¹) (τ : ℂ) := hΦ.mul continuousAt_const
    have h2 : ContinuousAt Complex.log (Φ τ * (Φ τ)⁻¹) := by
      rw [mul_inv_cancel₀ hne]; exact continuousAt_clog Complex.one_mem_slitPlane
    exact ContinuousAt.comp (f := fun z => Φ z * (Φ τ)⁻¹) (x := (τ : ℂ)) h2 h1
  have hΦne : ∀ᶠ z in 𝓝 (τ : ℂ), Φ z ≠ 0 := hΦ.eventually_ne hne
  have hLsmall : ∀ᶠ z in 𝓝 (τ : ℂ), ‖L z - L τ‖ < 1 := by
    have := (hLc.sub_const (L τ)).norm
    have h0 : ‖L (τ : ℂ) - L τ‖ < 1 := by simp
    exact this.eventually (gt_mem_nhds h0)
  have hℓsmall : ∀ᶠ z in 𝓝 (τ : ℂ), ‖ℓ z‖ < 1 := by
    have := hℓc.norm
    have h0 : ‖ℓ (τ : ℂ)‖ < 1 := by rw [hℓτ]; simp
    exact this.eventually (gt_mem_nhds h0)
  filter_upwards [hexp, hΦne, hLsmall, hℓsmall] with z hz hz0 h1 h2
  have hexpℓ : Complex.exp (ℓ z) = Φ z * (Φ τ)⁻¹ :=
    Complex.exp_log (mul_ne_zero hz0 (inv_ne_zero hne))
  have hexpτ : Complex.exp (L τ) = Φ τ := hexp.self_of_nhds
  have hone : Complex.exp (L z - L τ - ℓ z) = 1 := by
    rw [Complex.exp_sub, Complex.exp_sub, hz, hexpτ, hexpℓ]
    field_simp
  have hnorm : ‖L z - L τ - ℓ z‖ < 2 * π := by
    calc ‖L z - L τ - ℓ z‖ ≤ ‖L z - L τ‖ + ‖ℓ z‖ := norm_sub_le _ _
      _ < 1 + 1 := add_lt_add h1 h2
      _ ≤ 2 * π := by nlinarith [Real.pi_gt_three]
  have := eq_zero_of_exp_eq_one_of_norm_lt hone hnorm
  show L z = L τ + ℓ z
  linear_combination this

private theorem contDiffAt_log_lift {Φ L : ℂ → ℂ} {τ : ℍ} (hΦ : ContDiffAt ℝ 1 Φ (τ : ℂ))
    (hne : Φ τ ≠ 0) (hLc : ContinuousAt L (τ : ℂ))
    (hexp : ∀ᶠ z in 𝓝 (τ : ℂ), Complex.exp (L z) = Φ z) :
    ContDiffAt ℝ 1 L (τ : ℂ) := by
  have hev := eventuallyEq_log hΦ.continuousAt hne hLc hexp
  refine ContDiffAt.congr_of_eventuallyEq ?_ hev
  refine contDiffAt_const.add ?_
  have h1 : ContDiffAt ℝ 1 (fun z => Φ z * (Φ τ)⁻¹) (τ : ℂ) := hΦ.mul contDiffAt_const
  have h2 : ContDiffAt ℝ 1 Complex.log (Φ τ * (Φ τ)⁻¹) := by
    rw [mul_inv_cancel₀ hne]
    exact (Complex.contDiffAt_log Complex.one_mem_slitPlane).restrict_scalars ℝ
  exact ContDiffAt.comp (f := fun z => Φ z * (Φ τ)⁻¹) (τ : ℂ) h2 h1

private theorem hasFDerivAt_log_lift {Φ L : ℂ → ℂ} {τ : ℍ} (hΦ : ContDiffAt ℝ 1 Φ (τ : ℂ))
    (hne : Φ τ ≠ 0) (hLc : ContinuousAt L (τ : ℂ))
    (hexp : ∀ᶠ z in 𝓝 (τ : ℂ), Complex.exp (L z) = Φ z) :
    HasFDerivAt L ((Φ τ)⁻¹ • fderiv ℝ Φ τ) (τ : ℂ) := by
  have hLd : DifferentiableAt ℝ L (τ : ℂ) :=
    (contDiffAt_log_lift hΦ hne hLc hexp).differentiableAt (by norm_num)
  have hcomp : HasFDerivAt (fun z => Complex.exp (L z))
      (Complex.exp (L τ) • fderiv ℝ L τ) (τ : ℂ) :=
    (Complex.hasDerivAt_exp (L τ)).comp_hasFDerivAt (τ : ℂ) hLd.hasFDerivAt
  have hΦd : HasFDerivAt Φ (Complex.exp (L τ) • fderiv ℝ L τ) (τ : ℂ) :=
    hcomp.congr_of_eventuallyEq (by
      filter_upwards [hexp] with z hz using hz.symm)
  have hexpτ : Complex.exp (L τ) = Φ τ := hexp.self_of_nhds
  have hfd : fderiv ℝ Φ τ = Φ τ • fderiv ℝ L τ := by rw [hΦd.fderiv, hexpτ]
  have : (Φ τ)⁻¹ • fderiv ℝ Φ τ = fderiv ℝ L τ := by
    rw [hfd, smul_smul, inv_mul_cancel₀ hne, one_smul]
  rw [this]
  exact hLd.hasFDerivAt

end Local

section Global

/-- The primitive `L₀` on `ℍ`, read on all of `ℂ` through `ℍ`'s inclusion. -/
private def Lext (L₀ : C(ℍ, ℂ)) (z : ℂ) : ℂ := L₀ (UpperHalfPlane.ofComplex z)

private theorem Lext_coe (L₀ : C(ℍ, ℂ)) (τ : ℍ) : Lext L₀ τ = L₀ τ := by
  simp [Lext, UpperHalfPlane.ofComplex_apply]

private theorem continuousAt_Lext (L₀ : C(ℍ, ℂ)) (τ : ℍ) : ContinuousAt (Lext L₀) (τ : ℂ) := by
  have h : ContinuousAt (Lext L₀ ∘ UpperHalfPlane.coe) τ := by
    have : Lext L₀ ∘ UpperHalfPlane.coe = L₀ := funext fun τ => Lext_coe L₀ τ
    rw [this]; exact L₀.continuous.continuousAt
  exact (UpperHalfPlane.isOpenEmbedding_coe.continuousAt_iff).1 h

private theorem exp_Lext_eventually {Φ : ℂ → ℂ} (L₀ : C(ℍ, ℂ))
    (hL₀ : ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ) (τ : ℍ) :
    ∀ᶠ z in 𝓝 (τ : ℂ), Complex.exp (Lext L₀ z) = Φ z := by
  filter_upwards [isOpen_upperHalfPlaneSet.mem_nhds τ.im_pos] with z hz
  rw [Lext, UpperHalfPlane.ofComplex_apply_of_im_pos hz, hL₀]

private theorem contDiffAt_Lext {Φ : ℂ → ℂ} (hΦ : ∀ τ : ℍ, ContDiffAt ℝ 1 Φ τ)
    (hne : ∀ τ : ℍ, Φ τ ≠ 0) (L₀ : C(ℍ, ℂ)) (hL₀ : ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ)
    (τ : ℍ) : ContDiffAt ℝ 1 (Lext L₀) (τ : ℂ) :=
  contDiffAt_log_lift (hΦ τ) (hne τ) (continuousAt_Lext L₀ τ) (exp_Lext_eventually L₀ hL₀ τ)

private theorem hasFDerivAt_Lext {Φ : ℂ → ℂ} (hΦ : ∀ τ : ℍ, ContDiffAt ℝ 1 Φ τ)
    (hne : ∀ τ : ℍ, Φ τ ≠ 0) (L₀ : C(ℍ, ℂ)) (hL₀ : ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ)
    (τ : ℍ) : HasFDerivAt (Lext L₀) ((Φ τ)⁻¹ • fderiv ℝ Φ τ) (τ : ℂ) :=
  hasFDerivAt_log_lift (hΦ τ) (hne τ) (continuousAt_Lext L₀ τ) (exp_Lext_eventually L₀ hL₀ τ)

private theorem continuous_smul_upperHalfPlane (γ : SL(2, ℤ)) : Continuous fun τ : ℍ => γ • τ :=
  continuous_const_smul (γ : GL (Fin 2) ℝ)

/-- The coboundary `L₀ (γ • τ) - L₀ τ` of an invariant `Φ` is constant. -/
private theorem coboundary_const {Γ : Subgroup SL(2, ℤ)} {Φ : ℂ → ℂ} (L₀ : C(ℍ, ℂ))
    (hL₀ : ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ)
    (hinv : ∀ γ ∈ Γ, ∀ τ : ℍ, Φ ((γ • τ : ℍ) : ℂ) = Φ τ) (γ : SL(2, ℤ)) (hγ : γ ∈ Γ)
    (τ τ' : ℍ) : L₀ (γ • τ) - L₀ τ = L₀ (γ • τ') - L₀ τ' := by
  have hcont : Continuous fun τ : ℍ => L₀ (γ • τ) - L₀ τ :=
    (L₀.continuous.comp (continuous_smul_upperHalfPlane γ)).sub L₀.continuous
  have hexp : ∀ τ : ℍ, Complex.exp (L₀ (γ • τ) - L₀ τ) = 1 := by
    intro τ
    rw [Complex.exp_sub, hL₀, hL₀, hinv γ hγ τ, div_self (hL₀ τ ▸ Complex.exp_ne_zero _)]
  exact apply_eq_of_exp_eq_one hcont hexp τ τ'

private theorem exists_int_coboundary {Γ : Subgroup SL(2, ℤ)} {Φ : ℂ → ℂ} (L₀ : C(ℍ, ℂ))
    (hL₀ : ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ)
    (hinv : ∀ γ ∈ Γ, ∀ τ : ℍ, Φ ((γ • τ : ℍ) : ℂ) = Φ τ) (γ : SL(2, ℤ)) (hγ : γ ∈ Γ) :
    ∃ k : ℤ, ∀ τ : ℍ, L₀ (γ • τ) - L₀ τ = 2 * π * Complex.I * k := by
  have h1 : Complex.exp (L₀ (γ • UpperHalfPlane.I) - L₀ UpperHalfPlane.I) = 1 := by
    rw [Complex.exp_sub, hL₀, hL₀, hinv γ hγ, div_self (hL₀ _ ▸ Complex.exp_ne_zero _)]
  obtain ⟨k, hk⟩ := Complex.exp_eq_one_iff.1 h1
  refine ⟨k, fun τ => ?_⟩
  rw [coboundary_const L₀ hL₀ hinv γ hγ τ UpperHalfPlane.I, hk]
  ring

private def mInt {Γ : Subgroup SL(2, ℤ)} {Φ : ℂ → ℂ} (L₀ : C(ℍ, ℂ))
    (hL₀ : ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ)
    (hinv : ∀ γ ∈ Γ, ∀ τ : ℍ, Φ ((γ • τ : ℍ) : ℂ) = Φ τ) (γ : Γ) : ℤ :=
  (exists_int_coboundary L₀ hL₀ hinv γ γ.2).choose

private theorem mInt_spec {Γ : Subgroup SL(2, ℤ)} {Φ : ℂ → ℂ} (L₀ : C(ℍ, ℂ))
    (hL₀ : ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ)
    (hinv : ∀ γ ∈ Γ, ∀ τ : ℍ, Φ ((γ • τ : ℍ) : ℂ) = Φ τ) (γ : Γ) (τ : ℍ) :
    L₀ ((γ : SL(2, ℤ)) • τ) - L₀ τ = 2 * π * Complex.I * (mInt L₀ hL₀ hinv γ) :=
  (exists_int_coboundary L₀ hL₀ hinv γ γ.2).choose_spec τ

private theorem two_pi_I_ne_zero' : (2 * π * Complex.I : ℂ) ≠ 0 := by
  simp [Real.pi_ne_zero, Complex.I_ne_zero]

private theorem mInt_mul {Γ : Subgroup SL(2, ℤ)} {Φ : ℂ → ℂ} (L₀ : C(ℍ, ℂ))
    (hL₀ : ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ)
    (hinv : ∀ γ ∈ Γ, ∀ τ : ℍ, Φ ((γ • τ : ℍ) : ℂ) = Φ τ) (γ δ : Γ) :
    mInt L₀ hL₀ hinv (γ * δ) = mInt L₀ hL₀ hinv γ + mInt L₀ hL₀ hinv δ := by
  have h1 := mInt_spec L₀ hL₀ hinv (γ * δ) UpperHalfPlane.I
  have h2 := mInt_spec L₀ hL₀ hinv γ ((δ : SL(2, ℤ)) • UpperHalfPlane.I)
  have h3 := mInt_spec L₀ hL₀ hinv δ UpperHalfPlane.I
  have hsm : ((γ * δ : Γ) : SL(2, ℤ)) • UpperHalfPlane.I =
      (γ : SL(2, ℤ)) • ((δ : SL(2, ℤ)) • UpperHalfPlane.I) := by
    rw [← mul_smul]; rfl
  rw [hsm] at h1
  have : (2 * π * Complex.I : ℂ) * (mInt L₀ hL₀ hinv (γ * δ) : ℂ) =
      2 * π * Complex.I * ((mInt L₀ hL₀ hinv γ : ℂ) + mInt L₀ hL₀ hinv δ) := by
    linear_combination -h1 + h2 + h3
  have := mul_left_cancel₀ two_pi_I_ne_zero' this
  exact_mod_cast this

private def mHom {Γ : Subgroup SL(2, ℤ)} {Φ : ℂ → ℂ} (L₀ : C(ℍ, ℂ))
    (hL₀ : ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ)
    (hinv : ∀ γ ∈ Γ, ∀ τ : ℍ, Φ ((γ • τ : ℍ) : ℂ) = Φ τ) : Additive Γ →+ ℤ :=
  AddMonoidHom.mk' (fun γ => mInt L₀ hL₀ hinv (Additive.toMul γ)) fun γ δ =>
    mInt_mul L₀ hL₀ hinv (Additive.toMul γ) (Additive.toMul δ)

private theorem mHom_apply {Γ : Subgroup SL(2, ℤ)} {Φ : ℂ → ℂ} (L₀ : C(ℍ, ℂ))
    (hL₀ : ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ)
    (hinv : ∀ γ ∈ Γ, ∀ τ : ℍ, Φ ((γ • τ : ℍ) : ℂ) = Φ τ) (γ : Γ) :
    mHom L₀ hL₀ hinv (Additive.ofMul γ) = mInt L₀ hL₀ hinv γ := rfl

private theorem Lext_smul {Γ : Subgroup SL(2, ℤ)} {Φ : ℂ → ℂ} (L₀ : C(ℍ, ℂ))
    (hL₀ : ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ)
    (hinv : ∀ γ ∈ Γ, ∀ τ : ℍ, Φ ((γ • τ : ℍ) : ℂ) = Φ τ) (γ : Γ) (τ : ℍ) :
    Lext L₀ (((γ : SL(2, ℤ)) • τ : ℍ) : ℂ) =
      Lext L₀ τ + 2 * π * Complex.I * (mHom L₀ hL₀ hinv (Additive.ofMul γ) : ℂ) := by
  rw [Lext_coe, Lext_coe, mHom_apply, ← mInt_spec L₀ hL₀ hinv γ τ]
  ring

/-- The `2πiℤ`-cocycle of `Lext` makes it an equivariant primitive. -/
private theorem isEquivariantPrimitive {Γ : Subgroup SL(2, ℤ)} {Φ : ℂ → ℂ} (L₀ : C(ℍ, ℂ))
    (hL₀ : ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ)
    (hinv : ∀ γ ∈ Γ, ∀ τ : ℍ, Φ ((γ • τ : ℍ) : ℂ) = Φ τ) :
    ModularCurve.Period.IsEquivariantPrimitive Γ (fun τ : ℍ => Lext L₀ τ) :=
  fun γ => ⟨2 * π * Complex.I * (mHom L₀ hL₀ hinv (Additive.ofMul γ) : ℂ), fun τ => by
    show Lext L₀ _ - Lext L₀ _ = _
    rw [Lext_smul L₀ hL₀ hinv γ τ]; ring⟩

end Global

section Cusp

private def retract (A : ℝ) (hA : 0 < A) (τ : ℍ) : ℍ :=
  ⟨(τ.re : ℂ) + ((max τ.im A : ℝ) : ℂ) * Complex.I, by
    simpa using lt_max_of_lt_right hA⟩

private theorem continuous_retract (A : ℝ) (hA : 0 < A) : Continuous (retract A hA) := by
  unfold retract
  refine Continuous.upperHalfPlaneMk ?_ _
  exact (Complex.continuous_ofReal.comp UpperHalfPlane.continuous_re).add
    ((Complex.continuous_ofReal.comp (UpperHalfPlane.continuous_im.max continuous_const)).mul
      continuous_const)

private theorem im_retract (A : ℝ) (hA : 0 < A) (τ : ℍ) : (retract A hA τ).im = max τ.im A := by
  show ((τ.re : ℂ) + ((max τ.im A : ℝ) : ℂ) * Complex.I).im = max τ.im A
  simp

private theorem retract_of_le (A : ℝ) (hA : 0 < A) {τ : ℍ} (hτ : A ≤ τ.im) : retract A hA τ = τ := by
  apply UpperHalfPlane.ext
  simp only [retract, max_eq_left hτ]
  exact Complex.re_add_im _

/-- A primitive of an invariant function has a limit along every cusp. -/
private theorem exists_tendsto_cusp {Φ : ℂ → ℂ} (hΦc : ∀ τ : ℍ, ContinuousAt Φ τ)
    (L₀ : C(ℍ, ℂ)) (hL₀ : ∀ τ : ℍ, Complex.exp (L₀ τ) = Φ τ) (σ : SL(2, ℤ)) {c : ℂ}
    (hc : c ≠ 0) (hcT : Tendsto (fun τ : ℍ => Φ ((σ • τ : ℍ) : ℂ)) atImInfty (𝓝 c)) :
    ∃ c' : ℂ, Tendsto (fun τ : ℍ => L₀ (σ • τ)) atImInfty (𝓝 c') := by
  set ψ : ℍ → ℂ := fun τ => Φ ((σ • τ : ℍ) : ℂ) * c⁻¹ with hψ
  have hψT : Tendsto ψ atImInfty (𝓝 1) := by
    have := hcT.mul_const c⁻¹
    rwa [mul_inv_cancel₀ hc] at this
  have hψc : Continuous ψ := by
    have hΦcoe : Continuous fun τ : ℍ => Φ τ :=
      continuous_iff_continuousAt.2 fun τ => (hΦc τ).comp continuous_coe.continuousAt
    exact (hΦcoe.comp (continuous_smul_upperHalfPlane σ)).mul continuous_const
  obtain ⟨A₀, hA₀⟩ : ∃ A : ℝ, ∀ τ : ℍ, A ≤ τ.im → ‖ψ τ - 1‖ < 1 / 2 := by
    have h := hψT.sub_const (1 : ℂ)
    rw [sub_self] at h
    have := h.norm
    rw [norm_zero] at this
    have hev := this.eventually (gt_mem_nhds (by norm_num : (0 : ℝ) < 1 / 2))
    exact (UpperHalfPlane.atImInfty_mem _).1 hev
  set A : ℝ := max A₀ 1
  have hApos : 0 < A := lt_of_lt_of_le one_pos (le_max_right _ _)
  have hA : ∀ τ : ℍ, A ≤ τ.im → ‖ψ τ - 1‖ < 1 / 2 := fun τ hτ =>
    hA₀ τ (le_trans (le_max_left _ _) hτ)
  have hslit : ∀ τ : ℍ, A ≤ τ.im → ψ τ ∈ Complex.slitPlane := by
    intro τ hτ
    have : ψ τ = 1 + (ψ τ - 1) := by ring
    rw [this]
    exact Complex.mem_slitPlane_of_norm_lt_one (by linarith [hA τ hτ])
  have hψne : ∀ τ : ℍ, A ≤ τ.im → ψ τ ≠ 0 := fun τ hτ => Complex.slitPlane_ne_zero (hslit τ hτ)
  set r := retract A hApos
  have hrim : ∀ τ : ℍ, A ≤ (r τ).im := fun τ => by
    rw [show r τ = retract A hApos τ from rfl, im_retract]; exact le_max_right _ _
  set D : ℍ → ℂ := fun τ => L₀ (σ • r τ) - Complex.log (ψ (r τ)) - Complex.log c with hD
  have hDc : Continuous D := by
    refine ((L₀.continuous.comp ((continuous_smul_upperHalfPlane σ).comp
      (continuous_retract A hApos))).sub ?_).sub continuous_const
    refine continuous_iff_continuousAt.2 fun τ => ?_
    exact ContinuousAt.comp (f := fun τ => ψ (r τ)) (x := τ)
      (continuousAt_clog (hslit _ (hrim τ)))
      ((hψc.comp (continuous_retract A hApos)).continuousAt)
  have hDexp : ∀ τ, Complex.exp (D τ) = 1 := by
    intro τ
    have h1 : Complex.exp (L₀ (σ • r τ)) = Φ ((σ • r τ : ℍ) : ℂ) := hL₀ _
    have h2 : Complex.exp (Complex.log (ψ (r τ))) = ψ (r τ) :=
      Complex.exp_log (hψne _ (hrim τ))
    have h3 : Complex.exp (Complex.log c) = c := Complex.exp_log hc
    have hψne' : ψ (r τ) ≠ 0 := hψne _ (hrim τ)
    have hD' : D τ = L₀ (σ • r τ) - Complex.log (ψ (r τ)) - Complex.log c := rfl
    rw [hD', Complex.exp_sub, Complex.exp_sub, h1, h2, h3]
    have : ψ (r τ) = Φ ((σ • r τ : ℍ) : ℂ) * c⁻¹ := rfl
    have hΦne : Φ ((σ • r τ : ℍ) : ℂ) ≠ 0 := by
      rw [this] at hψne'; exact left_ne_zero_of_mul hψne'
    rw [this]
    field_simp
  have hDconst : ∀ τ, D τ = D UpperHalfPlane.I := fun τ => apply_eq_of_exp_eq_one hDc hDexp τ _
  refine ⟨0 + Complex.log c + D UpperHalfPlane.I, ?_⟩
  have hlog : Tendsto (fun τ : ℍ => Complex.log (ψ τ)) atImInfty (𝓝 0) := by
    have := (continuousAt_clog Complex.one_mem_slitPlane).tendsto.comp hψT
    rwa [Complex.log_one] at this
  have hmain : Tendsto (fun τ : ℍ => Complex.log (ψ τ) + Complex.log c + D UpperHalfPlane.I)
      atImInfty (𝓝 (0 + Complex.log c + D UpperHalfPlane.I)) :=
    (hlog.add_const _).add_const _
  refine hmain.congr' ?_
  rw [Filter.EventuallyEq, Filter.Eventually, UpperHalfPlane.atImInfty_mem]
  refine ⟨A, fun τ hτ => ?_⟩
  have hrτ : r τ = τ := retract_of_le A hApos hτ
  have := hDconst τ
  have hD' : D τ = L₀ (σ • r τ) - Complex.log (ψ (r τ)) - Complex.log c := rfl
  rw [hD', hrτ] at this
  show Complex.log (ψ τ) + Complex.log c + D UpperHalfPlane.I = L₀ (σ • τ)
  rw [← this]; ring

end Cusp

private theorem main (Γ : Subgroup SL(2, ℤ)) (Φ : ℂ → ℂ)
    (hΦ : ∀ τ : ℍ, ContDiffAt ℝ 1 Φ τ) (hne : ∀ τ : ℍ, Φ τ ≠ 0)
    (hinv : ∀ γ ∈ Γ, ∀ τ : ℍ, Φ ((γ • τ : ℍ) : ℂ) = Φ τ)
    (hcusp : ∀ σ : SL(2, ℤ), ∃ c : ℂ, c ≠ 0 ∧
      Tendsto (fun τ : ℍ => Φ ((σ • τ : ℍ) : ℂ)) atImInfty (𝓝 c)) :
    ∃ (L : ℂ → ℂ) (m : Additive Γ →+ ℤ),
      ModularCurve.Period.IsParabolicHom Γ m ∧
      (∀ τ : ℍ, ContDiffAt ℝ 1 L τ) ∧
      (∀ τ : ℍ, HasFDerivAt L ((Φ τ)⁻¹ • fderiv ℝ Φ τ) τ) ∧
      (∀ τ : ℍ, Complex.exp (L τ) = Φ τ) ∧
      (∀ (γ : Γ) (τ : ℍ), L (((γ : SL(2, ℤ)) • τ : ℍ) : ℂ) =
        L τ + 2 * π * Complex.I * (m (Additive.ofMul γ) : ℂ)) ∧
      (∀ σ : SL(2, ℤ), ∃ c : ℂ, Tendsto (fun τ : ℍ => L ((σ • τ : ℍ) : ℂ)) atImInfty (𝓝 c)) := by
  have hΦc : ∀ τ : ℍ, ContinuousAt Φ τ := fun τ => (hΦ τ).continuousAt
  obtain ⟨L₀, hL₀⟩ := exists_lift Φ hΦc hne
  have hlim : ∀ σ : SL(2, ℤ), ∃ c : ℂ,
      Tendsto (fun τ : ℍ => Lext L₀ ((σ • τ : ℍ) : ℂ)) atImInfty (𝓝 c) := by
    intro σ
    obtain ⟨c, hc, hcT⟩ := hcusp σ
    obtain ⟨c', hc'⟩ := exists_tendsto_cusp hΦc L₀ hL₀ σ hc hcT
    exact ⟨c', hc'.congr fun τ => (Lext_coe L₀ _).symm⟩
  have hpar : ModularCurve.Period.IsParabolicHom Γ (mHom L₀ hL₀ hinv) := by
    have hF := isEquivariantPrimitive L₀ hL₀ hinv
    have hpar' := ModularCurve.Period.IsEquivariantPrimitive.isParabolicHom_periodHom hF hlim
    intro γ hγ
    have h := hpar' γ hγ
    rw [ModularCurve.Period.IsEquivariantPrimitive.periodHom_apply,
      ModularCurve.Period.IsEquivariantPrimitive.period] at h
    change Lext L₀ (((γ : SL(2, ℤ)) • UpperHalfPlane.I : ℍ) : ℂ) - Lext L₀ UpperHalfPlane.I = 0 at h
    rw [Lext_smul L₀ hL₀ hinv γ] at h
    have h2 : (2 * π * Complex.I : ℂ) * (mHom L₀ hL₀ hinv (Additive.ofMul γ) : ℂ) = 0 := by
      linear_combination h
    exact_mod_cast (mul_eq_zero.1 h2).resolve_left two_pi_I_ne_zero'
  refine ⟨Lext L₀, mHom L₀ hL₀ hinv, hpar, contDiffAt_Lext hΦ hne L₀ hL₀,
    hasFDerivAt_Lext hΦ hne L₀ hL₀, fun τ => by rw [Lext_coe, hL₀], fun γ τ => ?_, hlim⟩
  exact Lext_smul L₀ hL₀ hinv γ τ

end WindingLog

end ModularCurve

/-- **A nowhere-zero invariant function with cusp limits is the exponential of a
primitive whose period map is a parabolic hom.** -/
theorem ModularCurve.exists_exp_eq_of_invariant_ne_zero_isParabolicHom (Γ : Subgroup SL(2, ℤ))
    (Φ : ℂ → ℂ) (hΦ : ∀ τ : ℍ, ContDiffAt ℝ 1 Φ τ) (hne : ∀ τ : ℍ, Φ τ ≠ 0)
    (hinv : ∀ γ ∈ Γ, ∀ τ : ℍ, Φ ((γ • τ : ℍ) : ℂ) = Φ τ)
    (hcusp : ∀ σ : SL(2, ℤ), ∃ c : ℂ, c ≠ 0 ∧
      Tendsto (fun τ : ℍ => Φ ((σ • τ : ℍ) : ℂ)) atImInfty (𝓝 c)) :
    ∃ (L : ℂ → ℂ) (m : Additive Γ →+ ℤ),
      ModularCurve.Period.IsParabolicHom Γ m ∧
        (∀ τ : ℍ, ContDiffAt ℝ 1 L τ) ∧
        (∀ τ : ℍ, HasFDerivAt L ((Φ τ)⁻¹ • fderiv ℝ Φ τ) τ) ∧
        (∀ τ : ℍ, Complex.exp (L τ) = Φ τ) ∧
        (∀ (γ : Γ) (τ : ℍ),
          L (((γ : SL(2, ℤ)) • τ : ℍ) : ℂ) = L τ + 2 * π * Complex.I * (m (Additive.ofMul γ) : ℂ)) ∧
        (∀ σ : SL(2, ℤ), ∃ c : ℂ,
          Tendsto (fun τ : ℍ => L ((σ • τ : ℍ) : ℂ)) atImInfty (𝓝 c)) :=
  ModularCurve.WindingLog.main Γ Φ hΦ hne hinv hcusp

/-! ### A parabolic hom `Γ → ZMod n` vanishing on torsion lifts to `Γ → ℤ`

The engine is the free-product structure of `SL(2, ℤ)`: `PSL(2, ℤ)` is
`(ZMod 2) ∗ (ZMod 3)`, so torsion is generated by conjugates of `T`, and a crossed
homomorphism on a free product is a coboundary as soon as it vanishes on the
Bass–Serre factors. That development — the pin's `P2mKuroshTor` prelude: crossed
homomorphisms, Shapiro's lemma, the transfer, and the cusp computation — is homed in
`FLTForHuman.GroupTheory.FreeProductCrossed`, which this module imports and which knows
nothing of `ModularCurve.Period`; only the `SL(2, ℤ)`-facing engine `main` stays here,
private, next to the headline that calls it. -/

section MainProof

open Matrix.SpecialLinearGroup ModularGroup FreeProductCrossed

/-- The free-product engine: a parabolic hom `Γ → ZMod n` vanishing on torsion is the
reduction mod `n` of a parabolic hom `Γ → ℤ`. The homomorphism descends to
`H = Γ.map ρ` in `G23 = (ZMod 2) ∗ (ZMod 3)`, is lifted there along the cusp sum,
and pulled back along `ρ`; `GroupTheory/FreeProductCrossed` supplies the
crossed-homomorphism and transfer machinery. -/
private theorem main (Γ : Subgroup SL(2, ℤ)) [Γ.FiniteIndex] (n : ℕ)
    (φ : ModularCurve.Period.parabolicHoms (ZMod n) Γ (ZMod n))
    (hφ : ∀ γ : Γ, IsOfFinOrder γ → (φ : Additive Γ →+ ZMod n) (Additive.ofMul γ) = 0) :
    ∃ x : ModularCurve.Period.parabolicHoms ℤ Γ ℤ,
      (Int.castAddHom (ZMod n)).comp (x : Additive Γ →+ ℤ) = (φ : Additive Γ →+ ZMod n) := by
  classical
  obtain ⟨e, he0, he1⟩ := ModularGroup.exists_mulEquiv_freeProduct_quotient_center
  let ρ : SL(2, ℤ) →* G23 := e.symm.toMonoidHom.comp (QuotientGroup.mk' (Subgroup.center SL(2, ℤ)))
  have hρ : ∀ z, ρ z = e.symm (QuotientGroup.mk z) := fun z => rfl
  have hker : ∀ z, ρ z = 1 ↔ z ∈ Subgroup.center SL(2, ℤ) := by
    intro z
    rw [hρ, MulEquiv.map_eq_one_iff, QuotientGroup.eq_one_iff]
  have hsurj : Function.Surjective ρ :=
    e.symm.surjective.comp (QuotientGroup.mk'_surjective _)
  have hT : ρ ModularGroup.T = tP := by
    have hSS : ModularGroup.S * (ModularGroup.S * ModularGroup.T)
        = (-1) * ModularGroup.T := by rw [← mul_assoc, S_mul_S]
    rw [hρ, MulEquiv.symm_apply_eq, tP, map_mul, he0, he1, ← QuotientGroup.mk_mul,
      QuotientGroup.eq, hSS, neg_one_mul, mul_neg, inv_mul_cancel]
    exact neg_one_mem_center
  let H : Subgroup G23 := Γ.map ρ
  have hFI : H.FiniteIndex := ⟨fun h0 =>
    Subgroup.FiniteIndex.index_ne_zero (H := Γ) (Nat.eq_zero_of_zero_dvd (h0 ▸ Γ.index_map_dvd hsurj))⟩
  have _ : H.FiniteIndex := hFI
  let ρΓ : Γ →* H := ρ.subgroupMap Γ
  have hρΓ : ∀ γ : Γ, ((ρΓ γ : H) : G23) = ρ γ := fun γ => rfl
  let ρΓa : Additive Γ →+ Additive H := MonoidHom.toAdditive ρΓ
  have hρΓa : ∀ γ : Γ, ρΓa (Additive.ofMul γ) = Additive.ofMul (ρΓ γ) := fun γ => rfl
  have hρΓa_surj : Function.Surjective ρΓa := ρ.subgroupMap_surjective Γ
  have hkerle : ρΓa.ker ≤ (φ : Additive Γ →+ ZMod n).ker := by
    refine Additive.ofMul.surjective.forall.mpr ?_
    intro γ hγ
    rw [AddMonoidHom.mem_ker] at hγ ⊢
    apply hφ γ
    have h1 : ρ γ = 1 := by
      rw [← hρΓ]
      have : ρΓ γ = 1 := hγ
      rw [this]; rfl
    have h2 : IsOfFinOrder (γ : SL(2, ℤ)) :=
      isOfFinOrder_of_rho ρ hker (by rw [h1]; exact IsOfFinOrder.one)
    exact Submonoid.isOfFinOrder_coe.mp h2
  let ψ : Additive H →+ ZMod n := ρΓa.liftOfSurjective hρΓa_surj ⟨(φ : Additive Γ →+ ZMod n), hkerle⟩
  have hψ : ∀ γ : Γ, ψ (Additive.ofMul (ρΓ γ)) = (φ : Additive Γ →+ ZMod n) (Additive.ofMul γ) := by
    intro γ
    rw [← hρΓa]
    exact AddMonoidHom.liftOfRightInverse_comp_apply ρΓa _ _ ⟨(φ : Additive Γ →+ ZMod n), hkerle⟩
      (Additive.ofMul γ)
  have hψ' : ∀ (P : G23) (hP : P ∈ H), ∃ γ : Γ, ρ γ = P ∧
      ψ (Additive.ofMul ⟨P, hP⟩) = (φ : Additive Γ →+ ZMod n) (Additive.ofMul γ) := by
    intro P hP
    obtain ⟨γ, hγ, hγP⟩ := Subgroup.mem_map.mp hP
    refine ⟨⟨γ, hγ⟩, hγP, ?_⟩
    have : (⟨P, hP⟩ : H) = ρΓ ⟨γ, hγ⟩ := Subtype.ext hγP.symm
    rw [this]
    exact hψ ⟨γ, hγ⟩
  have hψfac : ∀ (i : Fin 2) (x : M23 i) (g : G23) (h : g * Monoid.CoprodI.of x * g⁻¹ ∈ H),
      ψ (Additive.ofMul ⟨g * Monoid.CoprodI.of x * g⁻¹, h⟩) = 0 := by
    intro i x g h
    obtain ⟨γ, hγ, hval⟩ := hψ' _ h
    rw [hval]
    apply hφ γ
    exact Submonoid.isOfFinOrder_coe.mp (isOfFinOrder_of_rho_eq_conj_of ρ hker x g hγ)
  have hψpar : ∀ (g : G23) (k : ℤ) (h : g * tP ^ k * g⁻¹ ∈ H),
      ψ (Additive.ofMul ⟨g * tP ^ k * g⁻¹, h⟩) = 0 := by
    intro g k h
    obtain ⟨γ, hγ, hval⟩ := hψ' _ h
    rw [hval]
    exact φ.2 γ (trace_sq_of_rho_eq_conj_tP_zpow ρ hker hT hsurj hγ)
  obtain ⟨χ, hχ, -⟩ := exists_char_comp_eq_of_forall_conj_of H (Int.castAddHom (ZMod n))
    ZMod.intCast_surjective ψ hψfac
  have hdvd : ∀ (g : G23) (k : ℤ) (h : g * tP ^ k * g⁻¹ ∈ H),
      (n : ℤ) ∣ χ (Additive.ofMul ⟨_, h⟩) := by
    intro g k h
    apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ n).mp
    have := DFunLike.congr_fun hχ (Additive.ofMul ⟨_, h⟩)
    rw [AddMonoidHom.comp_apply, hψpar g k h] at this
    exact this
  obtain ⟨φ', hφ'⟩ := exists_sub_smul_apply_conj_zpow_eq_zero H χ n hdvd
  let x : Additive Γ →+ ℤ := (χ - (n : ℤ) • φ').comp ρΓa
  have hxpar : ModularCurve.Period.IsParabolicHom Γ x := by
    intro γ hγ
    obtain ⟨g, k, hgk⟩ := exists_rho_eq_conj_tP_zpow ρ hker hT hγ
    show (χ - (n : ℤ) • φ') (ρΓa (Additive.ofMul γ)) = 0
    have hmem : g * tP ^ k * g⁻¹ ∈ H := by rw [← hgk]; exact (ρΓ γ).2
    rw [hρΓa]
    have : ρΓ γ = ⟨g * tP ^ k * g⁻¹, hmem⟩ := Subtype.ext hgk
    rw [this]
    exact hφ' g k hmem
  refine ⟨⟨x, hxpar⟩, ?_⟩
  refine AddMonoidHom.ext (Additive.ofMul.surjective.forall.mpr ?_)
  intro γ
  show (Int.castAddHom (ZMod n)) ((χ - (n : ℤ) • φ') (ρΓa (Additive.ofMul γ)))
    = (φ : Additive Γ →+ ZMod n) (Additive.ofMul γ)
  rw [← hψ γ, hρΓa, AddMonoidHom.sub_apply, map_sub, AddMonoidHom.zsmul_apply, map_zsmul]
  have h1 : (Int.castAddHom (ZMod n)) (χ (Additive.ofMul (ρΓ γ))) = ψ (Additive.ofMul (ρΓ γ)) :=
    DFunLike.congr_fun hχ _
  rw [h1, sub_eq_self, natCast_zsmul, nsmul_eq_mul, ZMod.natCast_self, zero_mul]

end MainProof

/-- **A parabolic hom `Γ → ZMod n` vanishing on torsion lifts to a parabolic hom `Γ → ℤ`.**
The lift is the reduction mod `n` of an integer-valued parabolic hom. -/
theorem ModularCurve.Period.exists_parabolicHoms_int_castAddHom_comp_eq_of_forall_isOfFinOrder
    (Γ : Subgroup SL(2, ℤ)) [Γ.FiniteIndex] (n : ℕ)
    (φ : ModularCurve.Period.parabolicHoms (ZMod n) Γ (ZMod n))
    (hφ : ∀ γ : Γ, IsOfFinOrder γ →
      (φ : Additive Γ →+ ZMod n) (Additive.ofMul γ) = 0) :
    ∃ x : ModularCurve.Period.parabolicHoms ℤ Γ ℤ,
      (Int.castAddHom (ZMod n)).comp (x : Additive Γ →+ ℤ) = (φ : Additive Γ →+ ZMod n) :=
  main Γ n φ hφ
